# =====================================================================
# 展示用途的 GitHub Actions E2E 設定範例
#
# 此檔案刻意放在 .github/workflows/ 之外，且使用 .example 副檔名，
# 因此 GitHub 不會載入或執行。若要在其他專案啟用，請移到
# .github/workflows/e2e.yml，再設定下列 Secrets 與 Variables。
#
# Secrets：
#   TESTRAIL_URL / TESTRAIL_USER / TESTRAIL_API_KEY
#   SLACK_WEBHOOK_URL / SLACK_BOT_TOKEN / SLACK_CHANNEL_ID
#   ADMIN_STAGE_LOGIN_URL / ADMIN_STAGE_USERNAME / ADMIN_STAGE_PASSWORD
# Variables：
#   TESTRAIL_PROJECT_ID
# =====================================================================

name: E2E Tests

on:
  schedule:
    # UTC 時間；00:00 UTC = 台北 08:00
    - cron: "0 0 * * *"
  workflow_dispatch:
    inputs:
      test_env:
        description: "測試環境（對應 .env 的 {角色}_{環境}_* 前綴）"
        type: choice
        options: [STAGE, QA]
        default: STAGE
      tests:
        description: "要執行的案例，JSON 陣列"
        type: string
        default: '["test_case_sample"]'

# 同一分支重複觸發時，取消還在跑的舊 job，避免兩份測試同時打同一個站台。
concurrency:
  group: e2e-${{ github.ref }}
  cancel-in-progress: true

jobs:
  e2e:
    runs-on: ubuntu-latest
    timeout-minutes: 60

    env:
      PYTHONUNBUFFERED: "1"
      RUN_TIMEZONE: Asia/Taipei

      TESTRAIL_URL: ${{ secrets.TESTRAIL_URL }}
      TESTRAIL_USER: ${{ secrets.TESTRAIL_USER }}
      TESTRAIL_API_KEY: ${{ secrets.TESTRAIL_API_KEY }}
      TESTRAIL_PROJECT_ID: ${{ vars.TESTRAIL_PROJECT_ID }}

      SLACK_WEBHOOK_URL: ${{ secrets.SLACK_WEBHOOK_URL }}
      SLACK_BOT_TOKEN: ${{ secrets.SLACK_BOT_TOKEN }}
      SLACK_CHANNEL_ID: ${{ secrets.SLACK_CHANNEL_ID }}

      ADMIN_STAGE_LOGIN_URL: ${{ secrets.ADMIN_STAGE_LOGIN_URL }}
      ADMIN_STAGE_USERNAME: ${{ secrets.ADMIN_STAGE_USERNAME }}
      ADMIN_STAGE_PASSWORD: ${{ secrets.ADMIN_STAGE_PASSWORD }}

      # 手動觸發時採用輸入值，排程觸發時採用預設值。
      TEST_ENV: ${{ inputs.test_env || 'STAGE' }}
      TESTRAIL_TESTS: ${{ inputs.tests || '["test_case_sample"]' }}

      TESTRAIL_RUN_MODE: new
      TESTRAIL_REPORT_ENABLED: "true"
      SLACK_NOTIFY_ENABLED: "true"
      TESTRAIL_RECORD_VIDEO: "true"
      TESTRAIL_VERBOSE: "true"

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      # 快取瀏覽器本體（數百 MB），避免每次執行都重新下載。
      - name: Cache Playwright browsers
        id: playwright-cache
        uses: actions/cache@v4
        with:
          path: ~/.cache/ms-playwright
          key: playwright-${{ runner.os }}-${{ hashFiles('requirements.txt') }}

      - name: Install Playwright browsers
        run: python -m playwright install --with-deps chromium

      # 測試以 headed 模式執行，在無桌面的 runner 上需要虛擬顯示器。
      - name: Run E2E tests
        run: xvfb-run -a python run_qa_tests.py --name "GitHub Actions - ${{ github.run_number }}"

      # 失敗時的截圖與錄影是排查的主要依據，因此無論成敗都上傳。
      - name: Upload screenshots and videos
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: test-artifacts-${{ github.run_number }}
          path: IMG/
          retention-days: 7
          if-no-files-found: ignore

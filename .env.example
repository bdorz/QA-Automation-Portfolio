# =====================================================================
# 複製成 .env 後填入自己的值。.env 已被 .gitignore 排除，不會進版控。
# =====================================================================

# ---------------------------------------------------------------------
# TestRail API 連線（必填，程式碼內沒有預設值）
# ---------------------------------------------------------------------
TESTRAIL_URL=https://your-org.testrail.io/
TESTRAIL_USER=your-testrail-account@example.com
TESTRAIL_API_KEY=your-testrail-api-key

# TestRail 專案 ID
TESTRAIL_PROJECT_ID=1

# ---------------------------------------------------------------------
# Slack 通知（SLACK_NOTIFY_ENABLED=true 時才需要）
#   WEBHOOK 用於最終結果通知
#   BOT_TOKEN + CHANNEL_ID 用於執行中就地更新同一則進度訊息
# ---------------------------------------------------------------------
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# 進度訊息更新間隔秒數，設 0 代表只在案例完成時更新
SLACK_PROGRESS_INTERVAL_SECONDS=10

# ---------------------------------------------------------------------
# 執行模式：2 = 使用 TESTRAIL_MULTI_TESTS，3 = 使用 TESTRAIL_DAILY_TESTS
# ---------------------------------------------------------------------
TESTRAIL_RUN_MODE=3

# testcase 選擇器 JSON 陣列，可填 CASE_ID、TEST_RUN_ID 或檔名
TESTRAIL_MULTI_TESTS=["test_case_sample"]
TESTRAIL_DAILY_TESTS=["test_case_sample"]

# 主控台輸出與結果回報設定
TESTRAIL_VERBOSE=false
TESTRAIL_REPORT_ENABLED=true
SLACK_NOTIFY_ENABLED=false
TESTRAIL_RECORD_VIDEO=false

# ---------------------------------------------------------------------
# 受測站台：環境切換 0/QA 或 1/STAGE
# ---------------------------------------------------------------------
ADMIN_ENV_MODE=0

platform_QA_LOGIN_URL=https://qa.example.com/platform/login
platform_QA_ACCOUNT=your-qa-platform-account
platform_QA_PASSWORD=your-qa-platform-password
merchant_QA_LOGIN_URL=https://qa.example.com/merchant/<merchant-id>/login
merchant_QA_NAME=your-qa-merchant-name
merchant_QA_ACCOUNT=your-qa-merchant-account
merchant_QA_PASSWORD=your-qa-merchant-password

platform_STAGE_LOGIN_URL=https://stage.example.com/platform/login
platform_STAGE_ACCOUNT=your-stage-platform-account
platform_STAGE_PASSWORD=your-stage-platform-password
merchant_STAGE_LOGIN_URL=https://stage.example.com/merchant/<merchant-id>/login
merchant_STAGE_NAME=your-stage-merchant-name
merchant_STAGE_ACCOUNT=your-stage-merchant-account
merchant_STAGE_PASSWORD=your-stage-merchant-password

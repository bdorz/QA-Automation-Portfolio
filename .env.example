# =====================================================================
# 複製成 .env 後填入自己的值。.env 已被 .gitignore 排除，不會進版控。
# =====================================================================

# ---------------------------------------------------------------------
# TestRail API 連線（必填，程式碼內沒有預設值）
# ---------------------------------------------------------------------
TESTRAIL_URL=https://your-org.testrail.io/
TESTRAIL_USER=your-testrail-account@example.com
TESTRAIL_API_KEY=your-testrail-api-key

# TestRail 專案 ID
TESTRAIL_PROJECT_ID=1

# ---------------------------------------------------------------------
# Slack 通知（SLACK_NOTIFY_ENABLED=true 時才需要）
#   WEBHOOK 用於最終結果通知
#   BOT_TOKEN + CHANNEL_ID 用於執行中就地更新同一則進度訊息
# ---------------------------------------------------------------------
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# 進度訊息更新間隔秒數，設 0 代表只在案例完成時更新
SLACK_PROGRESS_INTERVAL_SECONDS=10

# ---------------------------------------------------------------------
# 執行模式：結果要回報到哪個 TestRail run
#   new      每次執行建立一個新的 run（適合排程的每日巡檢）
#   existing 不建立 run，沿用每支案例自己的 TEST_RUN_ID
# 舊版的數字寫法 2 = existing、3 = new 仍可使用。
# ---------------------------------------------------------------------
TESTRAIL_RUN_MODE=new

# 要執行的案例，JSON 陣列，可填 CASE_ID、TEST_RUN_ID 或檔名
TESTRAIL_TESTS=["test_case_sample"]

# 想讓兩種模式各跑不同案例時，可另外指定；未設定則沿用上面的 TESTRAIL_TESTS
# TESTRAIL_TESTS_NEW=["test_case_sample"]
# TESTRAIL_TESTS_EXISTING=["test_case_example_multi_step"]

# run 名稱時間戳使用的時區，未設定為 UTC
RUN_TIMEZONE=Asia/Taipei

# 主控台輸出與結果回報設定
TESTRAIL_VERBOSE=false
TESTRAIL_REPORT_ENABLED=true
SLACK_NOTIFY_ENABLED=false
TESTRAIL_RECORD_VIDEO=false

# ---------------------------------------------------------------------
# 受測站台登入資料
#
# 命名規則：{角色}_{環境}_{欄位}
#   - 切換環境：只改 TEST_ENV，整組帳密跟著換
#   - 新增角色：照同樣格式補一組，測試案例用 login(page, "角色") 取用，
#     共用模組完全不用改
# ---------------------------------------------------------------------
TEST_ENV=QA

ADMIN_QA_LOGIN_URL=https://qa.example.com/login
ADMIN_QA_USERNAME=your-qa-username
ADMIN_QA_PASSWORD=your-qa-password

ADMIN_STAGE_LOGIN_URL=https://stage.example.com/login
ADMIN_STAGE_USERNAME=your-stage-username
ADMIN_STAGE_PASSWORD=your-stage-password

# 需要第二個角色時，解除註解並填入即可使用 login(page, "user")
# USER_QA_LOGIN_URL=https://qa.example.com/login
# USER_QA_USERNAME=
# USER_QA_PASSWORD=
